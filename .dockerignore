# Keep the build context minimal: a .venv or a stale cache bust into the image
# layer, slow every build, and can leak local paths into the final image.
.git/
.github/
.venv/
venv/

__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

.env
.env.*
!.env.example

# Tests are not installed into the image; the Dockerfile copies src/ only.
tests/
bin/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Docs and manifests: not needed to run the service. README.md is the one
# exception — it is the project's declared readme, and hatchling needs it to
# build the wheel during `uv sync`.
AGENTS.md
CHANGELOG.md
cafaye.yml
docker-compose.yml
mise.toml
